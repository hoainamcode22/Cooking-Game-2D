#if UNITY_EDITOR
using System.Collections.Generic;
using System.IO;
using UnityEditor;
using UnityEngine;
using UnityEngine.Tilemaps;

/// <summary>
/// ============================================================================
/// Tools/Map45/11. Do Lo Dat Tu Hang Rao — bam theo hang rao DESIGNER DA VE
/// ============================================================================
///
/// Y TUONG
/// -------
/// Designer ve hang rao chia lo tren Tilemap_IsoFence. Tool nay:
///   1. Doc toan bo o co tile hang rao  -> coi la "TUONG".
///   2. Flood-fill cac o TRONG con lai  -> moi vung khep kin = MOT LO DAT.
///   3. Bo cac vung dinh mep ban do (vung "ngoai troi" khong phai lo).
///   4. Sinh LandRegionData cho tung lo: gia + cap mo tang dan theo khoang cach
///      toi lo trung tam (lo chua nha nguoi choi = dat khoi dau, mien phi).
///   5. Cam bang chi duong Prefab_Sprite_Sign_right vao CHINH GIUA moi lo.
///
/// Nho vay ban ve hang rao toi dau, dat duoc chia toi do — khong phai nhap tay.
/// Phan map chua ve hang rao co the chia tiep bang Tools/Map45/9.
/// </summary>
public class IsoFenceLotScanner : EditorWindow
{
    private const string AssetFolder = "Assets/_Game/Farm/Land";
    private const string SignPrefabPath =
        "Assets/maptitle/Design_Map/HappyHarvest_NatureDecor/Art/Environment/Signs/Sign Right/Prefab_Sprite_Sign_right.prefab";

    [Header("Nguon")]
    private Tilemap fenceTilemap;
    private int minLotCells = 6;        // vung nho hon coi la khe ho, bo qua
    private int maxLotCells = 4000;     // vung to hon coi la "ngoai troi"

    [Header("Kinh te")]
    private int basePrice = 2000;
    private float priceGrowth = 1.6f;
    private int baseUnlockLevel = 5;
    private int levelStep = 3;
    private int clearSeconds = 300;

    private readonly List<List<Vector2Int>> lots = new List<List<Vector2Int>>();
    private Vector2 scroll;
    private string status = "";

    [MenuItem("Tools/Map45/11. Do Lo Dat Tu Hang Rao Da Ve", false, 11)]
    public static void Open() => GetWindow<IsoFenceLotScanner>("Lo Dat Tu Hang Rao");

    private void OnEnable() => AutoFindFence();

    private void AutoFindFence()
    {
        if (fenceTilemap != null) return;
        var grid = GameObject.Find(IsoGrid.IsoGridObjectName);
        if (grid == null) return;
        var t = grid.transform.Find("Tilemap_IsoFence");
        if (t != null) fenceTilemap = t.GetComponent<Tilemap>();
    }

    private void OnGUI()
    {
        EditorGUILayout.HelpBox(
            "Doc hang rao ban da ve tren Tilemap_IsoFence, tu tach thanh cac LO DAT " +
            "khep kin, roi sinh du lieu + cam bang chi duong giua moi lo.",
            MessageType.Info);

        EditorGUILayout.Space();
        fenceTilemap = (Tilemap)EditorGUILayout.ObjectField("Tilemap hang rao", fenceTilemap, typeof(Tilemap), true);
        if (fenceTilemap == null && GUILayout.Button("Tu tim Tilemap_IsoFence")) AutoFindFence();

        EditorGUILayout.Space();
        EditorGUILayout.LabelField("Nhan dien lo", EditorStyles.boldLabel);
        minLotCells = EditorGUILayout.IntField("O toi thieu moi lo", minLotCells);
        maxLotCells = EditorGUILayout.IntField("O toi da moi lo", maxLotCells);
        EditorGUILayout.LabelField("Pham vi quet", "Tu dong = hop bao hang rao (toi da 600 o)");

        EditorGUILayout.Space();
        EditorGUILayout.LabelField("Kinh te", EditorStyles.boldLabel);
        basePrice       = EditorGUILayout.IntField("Gia lo dau tien", basePrice);
        priceGrowth     = EditorGUILayout.FloatField("He so tang gia", priceGrowth);
        baseUnlockLevel = EditorGUILayout.IntField("Cap mo lo gan nhat", baseUnlockLevel);
        levelStep       = EditorGUILayout.IntField("Cap tang moi lo", levelStep);
        clearSeconds    = EditorGUILayout.IntField("Giay don dep moi lo", clearSeconds);

        EditorGUILayout.Space();
        if (GUILayout.Button("1. Quet hang rao -> tim lo", GUILayout.Height(30))) ScanLots();

        EditorGUILayout.Space();
        if (lots.Count > 0)
        {
            EditorGUILayout.LabelField($"Tim thay {lots.Count} lo:", EditorStyles.boldLabel);
            scroll = EditorGUILayout.BeginScrollView(scroll, GUILayout.MaxHeight(220));
            for (int i = 0; i < lots.Count; i++)
            {
                var c = CenterCellOf(lots[i]);
                EditorGUILayout.LabelField($"  Lo {i + 1,2}:  {lots[i].Count,4} o   ·  tam o ({c.x}, {c.y})");
            }
            EditorGUILayout.EndScrollView();
        }
        else
        {
            EditorGUILayout.LabelField("Chua co lo nao — bam nut 1 o tren truoc.",
                                       EditorStyles.miniLabel);
        }

        // NUT 2 LUON HIEN (mo di khi chua quet) de khong ai phai di tim no nua
        EditorGUILayout.Space();
        using (new EditorGUI.DisabledScope(lots.Count == 0))
        {
            GUI.backgroundColor = lots.Count > 0 ? new Color(0.6f, 1f, 0.6f) : Color.white;
            if (GUILayout.Button(lots.Count > 0
                    ? $"2. Sinh du lieu {lots.Count} lo + cam bang chi duong"
                    : "2. Sinh du lieu lo + cam bang chi duong  (can quet truoc)",
                    GUILayout.Height(30)))
                GenerateRegions();
            GUI.backgroundColor = Color.white;
        }

        if (!string.IsNullOrEmpty(status))
        {
            EditorGUILayout.Space();
            EditorGUILayout.HelpBox(status, MessageType.None);
        }
    }

    // ─────────────────────────────────────────────────────────────────────
    private void ScanLots()
    {
        lots.Clear();
        status = "";
        if (fenceTilemap == null) { status = "Chua co Tilemap hang rao."; return; }

        // ── 1. Tap o co hang rao = TUONG ─────────────────────────────────
        var walls = new HashSet<Vector2Int>();
        var bounds = fenceTilemap.cellBounds;
        for (int x = bounds.xMin; x < bounds.xMax; x++)
            for (int y = bounds.yMin; y < bounds.yMax; y++)
                if (fenceTilemap.GetTile(new Vector3Int(x, y, 0)) != null)
                    walls.Add(new Vector2Int(x, y));

        if (walls.Count == 0) { status = "Tilemap hang rao khong co tile nao."; return; }

        // ── 2. Vung quet = HOP BAO THAT cua hang rao + 2 o le ────────────
        // (ban truoc kep ve mot ban kinh co dinh quanh tam => cat ngang cac lo, roi luat
        //  "loai vung cham bien" xoa sach tat ca => luon ra 0 lo.)
        int minX = int.MaxValue, maxX = int.MinValue, minY = int.MaxValue, maxY = int.MinValue;
        foreach (var w in walls)
        {
            minX = Mathf.Min(minX, w.x); maxX = Mathf.Max(maxX, w.x);
            minY = Mathf.Min(minY, w.y); maxY = Mathf.Max(maxY, w.y);
        }
        minX -= 2; maxX += 2; minY -= 2; maxY += 2;

        // chan an toan: khong quet qua rong keo Unity treo
        const int HardLimit = 600;
        int wCells = maxX - minX + 1, hCells = maxY - minY + 1;
        if (wCells > HardLimit || hCells > HardLimit)
        {
            int cx0 = (minX + maxX) / 2, cy0 = (minY + maxY) / 2;
            minX = cx0 - HardLimit / 2; maxX = cx0 + HardLimit / 2;
            minY = cy0 - HardLimit / 2; maxY = cy0 + HardLimit / 2;
        }

        // ── 3. Flood-fill moi vung TRONG ─────────────────────────────────
        var visited = new HashSet<Vector2Int>();
        var all = new List<List<Vector2Int>>();
        var outdoorIdx = new HashSet<int>();   // vung noi ra ngoai ban do

        for (int x = minX; x <= maxX; x++)
        {
            for (int y = minY; y <= maxY; y++)
            {
                var start = new Vector2Int(x, y);
                if (walls.Contains(start) || visited.Contains(start)) continue;

                var region = new List<Vector2Int>();
                var stack = new Stack<Vector2Int>();
                stack.Push(start); visited.Add(start);
                bool reachesOutside = false;

                while (stack.Count > 0)
                {
                    var c = stack.Pop();
                    region.Add(c);

                    foreach (var d in Dirs)
                    {
                        var n = c + d;
                        // cham bien vung quet = vung nay THONG ra ngoai ban do
                        if (n.x < minX || n.x > maxX || n.y < minY || n.y > maxY)
                        { reachesOutside = true; continue; }
                        if (walls.Contains(n) || visited.Contains(n)) continue;
                        visited.Add(n); stack.Push(n);
                    }
                }

                if (reachesOutside) outdoorIdx.Add(all.Count);
                all.Add(region);
            }
        }

        // ── 4. Loc: bo vung ngoai troi, bo vung qua nho / qua to ─────────
        int outdoor = 0, tooSmall = 0, tooBig = 0;
        for (int i = 0; i < all.Count; i++)
        {
            var r = all[i];
            if (outdoorIdx.Contains(i)) { outdoor++; continue; }
            if (r.Count < minLotCells) { tooSmall++; continue; }
            if (r.Count > maxLotCells) { tooBig++; continue; }
            lots.Add(r);
        }

        // lo gan tam ban do dung truoc (lo khoi dau)
        int cx = (minX + maxX) / 2, cy = (minY + maxY) / 2;
        var origin = new Vector2Int(cx, cy);
        lots.Sort((a, b) => Dist(CenterCellOf(a), origin).CompareTo(Dist(CenterCellOf(b), origin)));

        // ── 5. Bao cao ───────────────────────────────────────────────────
        status =
            $"Quet xong tren vung {wCells} x {hCells} o.\n" +
            $"  · {walls.Count} tile hang rao\n" +
            $"  · {all.Count} vung trong tim duoc\n" +
            $"  · loai {outdoor} vung ngoai troi, {tooSmall} vung qua nho (< {minLotCells} o), " +
            $"{tooBig} vung qua to (> {maxLotCells} o)\n" +
            $"  => CON {lots.Count} LO.\n";

        if (lots.Count == 0)
        {
            status += "\nKhong ra lo nao. Thu:\n";
            if (tooSmall > 0) status += $"  • Giam 'O toi thieu moi lo' xuong ~2 (dang {minLotCells}) — co {tooSmall} vung bi loai vi nho.\n";
            if (tooBig > 0)   status += $"  • Tang 'O toi da moi lo' (dang {maxLotCells}) — co {tooBig} vung bi loai vi to.\n";
            if (outdoor == all.Count) status += "  • MOI vung deu thong ra ngoai => hang rao chua KHEP KIN o dau do.\n";
        }
        else status += "\nBam nut 2 ben duoi de sinh du lieu.";

        Debug.Log($"[LoDat] {status}");
    }

    private static readonly Vector2Int[] Dirs =
    {
        new Vector2Int(1, 0), new Vector2Int(-1, 0),
        new Vector2Int(0, 1), new Vector2Int(0, -1)
    };

    private static int Dist(Vector2Int a, Vector2Int b)
        => Mathf.Abs(a.x - b.x) + Mathf.Abs(a.y - b.y);

    private static Vector2Int CenterCellOf(List<Vector2Int> cells)
    {
        long sx = 0, sy = 0;
        foreach (var c in cells) { sx += c.x; sy += c.y; }
        return new Vector2Int((int)(sx / cells.Count), (int)(sy / cells.Count));
    }

    // ─────────────────────────────────────────────────────────────────────
    private void GenerateRegions()
    {
        if (lots.Count == 0) return;
        if (!Directory.Exists(AssetFolder)) Directory.CreateDirectory(AssetFolder);

        var signPrefab = AssetDatabase.LoadAssetAtPath<GameObject>(SignPrefabPath);
        if (signPrefab == null)
            Debug.LogWarning($"[LoDat] Khong tim thay bang chi duong tai {SignPrefabPath}");

        var created = new List<LandRegionData>();
        for (int i = 0; i < lots.Count; i++)
        {
            var cells = lots[i];
            string id = $"lot_{i:00}";
            string path = $"{AssetFolder}/Lot_{i:00}.asset";

            var data = AssetDatabase.LoadAssetAtPath<LandRegionData>(path);
            if (data == null)
            {
                data = CreateInstance<LandRegionData>();
                AssetDatabase.CreateAsset(data, path);
            }

            data.regionId    = id;
            data.displayName = i == 0 ? "Dat Khoi Dau" : $"Lo {i}";
            data.cellRects   = ToRects(cells);
            data.unlockedByDefault = (i == 0);
            data.unlockLevel = i == 0 ? 0 : baseUnlockLevel + (i - 1) * levelStep;
            data.goldPrice   = i == 0 ? 0
                             : Mathf.RoundToInt(basePrice * Mathf.Pow(priceGrowth, i - 1) / 10f) * 10;
            data.gemPrice    = 0;
            data.clearSeconds = i == 0 ? 0 : clearSeconds;
            data.workerCount = 4;
            data.requiredRegionIds = new List<string>();
            if (i > 1) data.requiredRegionIds.Add($"lot_{(i - 1):00}");

            // nguyen lieu tang dan theo lo
            data.materialCosts = new List<BuildMaterialCost>();
            if (i > 0)
            {
                int k = Mathf.Max(1, i);
                data.materialCosts.Add(new BuildMaterialCost("go",   6 + k * 3));
                data.materialCosts.Add(new BuildMaterialCost("da",   4 + k * 2));
                if (i >= 2) data.materialCosts.Add(new BuildMaterialCost("dinh", 2 + k * 2));
                if (i >= 3) data.materialCosts.Add(new BuildMaterialCost("kinh", 2 + k));
            }

            EditorUtility.SetDirty(data);
            created.Add(data);
        }

        AssetDatabase.SaveAssets();
        AssetDatabase.Refresh();

        // nap vao manager + gan bang chi duong
        var mgr = Object.FindFirstObjectByType<LandExpansionManager>();
        if (mgr == null)
        {
            var root = new GameObject("LandExpansion");
            mgr = root.AddComponent<LandExpansionManager>();
        }
        mgr.regions.Clear();
        mgr.regions.AddRange(created);
        if (signPrefab != null) mgr.signPrefab = signPrefab;
        mgr.designerFenceTilemap = fenceTilemap;
        EditorUtility.SetDirty(mgr);

        status = $"Da sinh {created.Count} lo vao {AssetFolder} va nap vao LandExpansion.\n" +
                 "Nho Save Scene (Ctrl+S).";
        Debug.Log($"[LoDat] {status}");
        EditorUtility.DisplayDialog("Lo Dat Tu Hang Rao", status, "OK");
    }

    /// <summary>Gom cac o roi thanh cac RectInt lien nhau theo tung hang (it rect hon => nhe hon).</summary>
    private static List<RectInt> ToRects(List<Vector2Int> cells)
    {
        var set = new HashSet<Vector2Int>(cells);
        var used = new HashSet<Vector2Int>();
        var rects = new List<RectInt>();

        var sorted = new List<Vector2Int>(cells);
        sorted.Sort((a, b) => a.y != b.y ? a.y.CompareTo(b.y) : a.x.CompareTo(b.x));

        foreach (var c in sorted)
        {
            if (used.Contains(c)) continue;

            // keo dai sang phai
            int w = 1;
            while (set.Contains(new Vector2Int(c.x + w, c.y)) &&
                   !used.Contains(new Vector2Int(c.x + w, c.y))) w++;

            // keo cao len tren neu ca hang deu trong
            int h = 1;
            bool grow = true;
            while (grow)
            {
                for (int x = c.x; x < c.x + w; x++)
                {
                    var probe = new Vector2Int(x, c.y + h);
                    if (!set.Contains(probe) || used.Contains(probe)) { grow = false; break; }
                }
                if (grow) h++;
            }

            for (int x = c.x; x < c.x + w; x++)
                for (int y = c.y; y < c.y + h; y++)
                    used.Add(new Vector2Int(x, y));

            rects.Add(new RectInt(c.x, c.y, w, h));
        }
        return rects;
    }
}
#endif
