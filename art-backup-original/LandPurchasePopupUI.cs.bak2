using System.Collections.Generic;
using UnityEngine;
using UnityEngine.UI;

/// <summary>
/// ============================================================================
/// POPUP MUA O DAT — dung 100% bang code, khong can prefab
/// ============================================================================
///
/// Bo cuc (theo yeu cau):
///   ┌──────────────────────────────────────┐
///   │  [khung go]              (X) tron    │
///   │        MO RONG DAT                   │
///   │   Khu Bac  ·  64 o dat               │
///   │  ┌────┐ ┌────┐ ┌────┐ ┌────┐         │  <- card bo goc tung nguyen lieu
///   │  │ Go │ │ Da │ │Kinh│ │Dinh│         │     so do = thieu, trang = du
///   │  │12/8│ │ 8/8│ │4/10│ │ 6/6│         │
///   │  └────┘ └────┘ └────┘ └────┘         │
///   │        [ 2.400 vang ]  [ MUA ]       │
///   └──────────────────────────────────────┘
///
/// Sprite lay tu UIStandardSprites de dong bo voi cac popup khac trong game:
///   khung go = FrameWood, giay = PanelPaper, nut close = Close.
///
/// Cach dung:
///   LandPurchasePopupUI.Show(region, manager);
/// </summary>
public class LandPurchasePopupUI : MonoBehaviour
{
    private static LandPurchasePopupUI _instance;

    private LandRegionData _region;
    private LandExpansionManager _manager;

    private Canvas _canvas;
    private Text _txtTitle, _txtSub, _txtGold, _txtBuy, _txtWarn;
    private Button _btnBuy, _btnClose;
    private Transform _cardRow;
    private readonly List<(Text amount, string itemId)> _cards = new List<(Text, string)>();

    // ─────────────────────────────────────────────────────────────────────
    public static void Show(LandRegionData region, LandExpansionManager manager)
    {
        if (region == null || manager == null) return;
        if (_instance == null)
        {
            var go = new GameObject("LandPurchasePopup");
            _instance = go.AddComponent<LandPurchasePopupUI>();
            _instance.Build();
        }
        _instance.Bind(region, manager);
        _instance.gameObject.SetActive(true);
    }

    public static void Hide()
    {
        if (_instance != null) _instance.gameObject.SetActive(false);
    }

    // ─────────────────────────────────────────────────────────────────────
    private void Build()
    {
        _canvas = gameObject.AddComponent<Canvas>();
        _canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        _canvas.sortingOrder = 3000;
        var scaler = gameObject.AddComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1920, 1080);
        scaler.matchWidthOrHeight = 0.5f;
        gameObject.AddComponent<GraphicRaycaster>();

        // nen mo toan man — bam ra ngoai de dong
        var dim = NewImage(transform, "Dim", new Color(0f, 0f, 0f, 0.55f));
        Stretch(dim.rectTransform);
        var dimBtn = dim.gameObject.AddComponent<Button>();
        dimBtn.transition = Selectable.Transition.None;
        dimBtn.onClick.AddListener(Hide);

        // khung go
        var frame = NewImage(transform, "Frame", Color.white, Sprite_FrameWood());
        frame.type = Image.Type.Sliced;
        var fr = frame.rectTransform;
        fr.anchorMin = fr.anchorMax = new Vector2(0.5f, 0.5f);
        fr.pivot = new Vector2(0.5f, 0.5f);
        fr.anchoredPosition = Vector2.zero;
        fr.sizeDelta = new Vector2(820, 560);

        // giay ben trong
        var paper = NewImage(frame.transform, "Paper", Color.white, Sprite_Paper());
        paper.type = Image.Type.Sliced;
        var pr = paper.rectTransform;
        pr.anchorMin = new Vector2(0f, 0f); pr.anchorMax = new Vector2(1f, 1f);
        pr.offsetMin = new Vector2(38, 38); pr.offsetMax = new Vector2(-38, -38);

        _txtTitle = NewText(frame.transform, "Title", "MO RONG DAT", 46, FontStyle.Bold,
                            new Color(0.36f, 0.22f, 0.10f));
        Anchor(_txtTitle.rectTransform, new Vector2(0.5f, 1f), new Vector2(0, -78), new Vector2(700, 60));

        _txtSub = NewText(frame.transform, "Sub", "", 30, FontStyle.Normal,
                          new Color(0.45f, 0.32f, 0.18f));
        Anchor(_txtSub.rectTransform, new Vector2(0.5f, 1f), new Vector2(0, -132), new Vector2(700, 44));

        // hang card nguyen lieu
        var row = new GameObject("CardRow", typeof(RectTransform));
        row.transform.SetParent(frame.transform, false);
        _cardRow = row.transform;
        var rr = (RectTransform)row.transform;
        Anchor(rr, new Vector2(0.5f, 1f), new Vector2(0, -290), new Vector2(700, 190));
        var hl = row.AddComponent<HorizontalLayoutGroup>();
        hl.spacing = 18; hl.childAlignment = TextAnchor.MiddleCenter;
        hl.childForceExpandWidth = false; hl.childForceExpandHeight = false;

        // dong canh bao thieu do
        _txtWarn = NewText(frame.transform, "Warn", "", 26, FontStyle.Bold, new Color(0.80f, 0.22f, 0.18f));
        Anchor(_txtWarn.rectTransform, new Vector2(0.5f, 1f), new Vector2(0, -398), new Vector2(720, 40));

        // gia vang
        _txtGold = NewText(frame.transform, "Gold", "", 34, FontStyle.Bold, new Color(0.30f, 0.22f, 0.10f));
        Anchor(_txtGold.rectTransform, new Vector2(0.5f, 0f), new Vector2(-170, 92), new Vector2(300, 56));

        // nut MUA
        var buy = NewImage(frame.transform, "BtnBuy", new Color(0.36f, 0.72f, 0.30f), Sprite_BtnGem());
        buy.type = Image.Type.Sliced;
        Anchor(buy.rectTransform, new Vector2(0.5f, 0f), new Vector2(170, 92), new Vector2(260, 84));
        _btnBuy = buy.gameObject.AddComponent<Button>();
        _btnBuy.targetGraphic = buy;
        _btnBuy.onClick.AddListener(OnBuy);
        _txtBuy = NewText(buy.transform, "Label", "MUA", 34, FontStyle.Bold, Color.white);
        Stretch(_txtBuy.rectTransform);

        // nut close tron goc phai tren
        var close = NewImage(frame.transform, "BtnClose", Color.white, Sprite_Close());
        Anchor(close.rectTransform, new Vector2(1f, 1f), new Vector2(-26, -26), new Vector2(76, 76));
        close.rectTransform.pivot = new Vector2(1f, 1f);
        _btnClose = close.gameObject.AddComponent<Button>();
        _btnClose.targetGraphic = close;
        _btnClose.onClick.AddListener(Hide);
        if (close.sprite == null)
        {
            close.color = new Color(0.85f, 0.26f, 0.22f);
            var x = NewText(close.transform, "X", "X", 40, FontStyle.Bold, Color.white);
            Stretch(x.rectTransform);
        }
    }

    // ─────────────────────────────────────────────────────────────────────
    private void Bind(LandRegionData region, LandExpansionManager manager)
    {
        _region = region;
        _manager = manager;

        _txtSub.text = $"{region.displayName}  ·  {region.AreaCells} o dat";
        _txtGold.text = region.goldPrice > 0 ? $"{region.goldPrice:n0} vang"
                      : region.gemPrice  > 0 ? $"{region.gemPrice} kim cuong" : "Mien phi";

        // dung lai cac card nguyen lieu
        for (int i = _cardRow.childCount - 1; i >= 0; i--) Destroy(_cardRow.GetChild(i).gameObject);
        _cards.Clear();
        foreach (var c in region.materialCosts)
        {
            if (!c.IsValid) continue;
            MakeCard(c);
        }
        Refresh();
    }

    private void MakeCard(BuildMaterialCost cost)
    {
        var card = NewImage(_cardRow, $"Card_{cost.itemId}", Color.white, Sprite_Paper());
        card.type = Image.Type.Sliced;
        var le = card.gameObject.AddComponent<LayoutElement>();
        le.preferredWidth = 150; le.preferredHeight = 170;

        var icon = NewImage(card.transform, "Icon", Color.white, BuildMaterials.IconOf(cost.itemId));
        Anchor(icon.rectTransform, new Vector2(0.5f, 1f), new Vector2(0, -18), new Vector2(88, 88));
        icon.preserveAspect = true;
        if (icon.sprite == null) icon.color = new Color(0.75f, 0.65f, 0.5f);

        var name = NewText(card.transform, "Name", BuildMaterials.DisplayNameOf(cost.itemId),
                           24, FontStyle.Normal, new Color(0.42f, 0.30f, 0.16f));
        Anchor(name.rectTransform, new Vector2(0.5f, 1f), new Vector2(0, -112), new Vector2(140, 30));

        var amount = NewText(card.transform, "Amount", "", 28, FontStyle.Bold, Color.black);
        Anchor(amount.rectTransform, new Vector2(0.5f, 0f), new Vector2(0, 22), new Vector2(140, 34));

        _cards.Add((amount, cost.itemId));
    }

    /// <summary>Cap nhat so luong / mau / trang thai nut.</summary>
    public void Refresh()
    {
        if (_region == null) return;

        bool enoughMat = true;
        foreach (var (txt, id) in _cards)
        {
            int need = 0;
            foreach (var c in _region.materialCosts)
                if (c.itemId == id) { need = c.amount; break; }
            int own = BuildMaterials.Owned(id);
            bool ok = own >= need;
            enoughMat &= ok;
            txt.text = $"{own}/{need}";
            txt.color = ok ? new Color(0.20f, 0.50f, 0.18f) : new Color(0.80f, 0.22f, 0.18f);
        }

        string why = null;
        bool can = false;
        if (_manager != null) can = _manager.CanBuy(_region, out why);
        else why = "Chua san sang.";
        if (can && !enoughMat)
            why = "Thieu nguyen lieu: " + BuildMaterials.Describe(_region.materialCosts, true);

        bool allow = can && enoughMat;
        _txtWarn.text = allow ? "" : (why ?? "");
        _btnBuy.interactable = allow;
        var img = _btnBuy.GetComponent<Image>();
        if (img != null) img.color = allow ? new Color(0.36f, 0.72f, 0.30f) : new Color(0.62f, 0.62f, 0.62f);
    }

    private void OnEnable()  { InvokeRepeating(nameof(Refresh), 0.4f, 0.6f); }
    private void OnDisable() { CancelInvoke(nameof(Refresh)); }

    // ─────────────────────────────────────────────────────────────────────
    private void OnBuy()
    {
        if (_region == null || _manager == null) return;
        if (!BuildMaterials.HasAll(_region.materialCosts)) { Refresh(); return; }
        if (!_manager.CanBuy(_region, out _)) { Refresh(); return; }

        // tru nguyen lieu truoc, roi tru tien (TryBuy tu tru tien)
        if (!BuildMaterials.TrySpend(_region.materialCosts)) { Refresh(); return; }

        if (!_manager.TryBuyAndStartClearing(_region))
        {
            // tra lai nguyen lieu neu tru tien that bai
            var inv = FarmInventoryManager.Instance;
            if (inv != null)
                foreach (var c in _region.materialCosts)
                    if (c.IsValid) inv.AddItem(c.itemId, c.amount);
            Refresh();
            return;
        }
        Hide();
    }

    // ─────────────────────────────────────────────────────────────────────
    // Helper dung UI
    // ─────────────────────────────────────────────────────────────────────
    private static Sprite Sprite_FrameWood() => LoadUI("FrameWood", "popup_frame_wood");
    private static Sprite Sprite_Paper()     => LoadUI("PanelPaper", "popup_panel_paper");
    private static Sprite Sprite_Close()     => LoadUI("Close", "btn_close");
    private static Sprite Sprite_BtnGem()    => LoadUI("BtnGem", "proc_btn_blue");

    /// <summary>
    /// Lay sprite chuan tu UIStandardSprites qua reflection (de khong phu thuoc
    /// cung tap hop field, va van chay neu class do doi ten field).
    /// </summary>
    private static Sprite LoadUI(string propName, string fallbackResource)
    {
        var t = System.Type.GetType("UIStandardSprites");
        if (t != null)
        {
            var p = t.GetProperty(propName, System.Reflection.BindingFlags.Public |
                                            System.Reflection.BindingFlags.Static);
            if (p != null && p.GetValue(null) is Sprite s && s != null) return s;
            var f = t.GetField(propName, System.Reflection.BindingFlags.Public |
                                         System.Reflection.BindingFlags.Static);
            if (f != null && f.GetValue(null) is Sprite s2 && s2 != null) return s2;
        }
        return Resources.Load<Sprite>(fallbackResource);
    }

    private static Image NewImage(Transform parent, string name, Color c, Sprite s = null)
    {
        var go = new GameObject(name, typeof(RectTransform));
        go.transform.SetParent(parent, false);
        var img = go.AddComponent<Image>();
        img.color = c; img.sprite = s;
        return img;
    }

    private static Text NewText(Transform parent, string name, string content, int size,
                                FontStyle style, Color color)
    {
        var go = new GameObject(name, typeof(RectTransform));
        go.transform.SetParent(parent, false);
        var t = go.AddComponent<Text>();
        t.text = content;
        t.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        t.fontSize = size; t.fontStyle = style; t.color = color;
        t.alignment = TextAnchor.MiddleCenter;
        t.horizontalOverflow = HorizontalWrapMode.Overflow;
        return t;
    }

    private static void Stretch(RectTransform rt)
    {
        rt.anchorMin = Vector2.zero; rt.anchorMax = Vector2.one;
        rt.offsetMin = Vector2.zero; rt.offsetMax = Vector2.zero;
    }

    private static void Anchor(RectTransform rt, Vector2 anchor, Vector2 pos, Vector2 size)
    {
        rt.anchorMin = rt.anchorMax = anchor;
        rt.pivot = new Vector2(0.5f, 0.5f);
        rt.anchoredPosition = pos;
        rt.sizeDelta = size;
    }
}
